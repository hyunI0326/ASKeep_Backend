# 기존 PostgreSQL 볼륨을 쓰면 생성 당시 비밀번호와 일치시킨다.
# 새 서버에 배포할 때는 password 대신 별도의 비밀번호를 설정한다.
DB_PASSWORD=password
OPENAI_API_KEY=
# openssl rand -hex 32 로 생성한 값을 넣는다.
JWT_SECRET=
# 비밀번호 재설정 인증코드 메일(SMTP). 비워 두면 메일 대신 backend 로그에 코드가 찍힌다.
# Gmail 예: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=계정@gmail.com, MAIL_PASSWORD=앱 비밀번호(16자리)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://askeep.vercel.app
